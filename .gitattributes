# Normalise line endings to LF for all text files.
* text=auto eol=lf

# Exclude development cruft from the distributed package (dist archives).
/tests           export-ignore
/examples        export-ignore
/.github         export-ignore
/phpunit.xml     export-ignore
/phpstan.neon    export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
